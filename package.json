{
  "name": "ajocircle-full",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix apps/admin && npm install --prefix apps/mobile",
    "dev": "npm run dev:web",
    "dev:web": "next dev",
    "dev:backend": "npm run dev --prefix backend",
    "dev:admin": "npm run dev --prefix apps/admin",
    "dev:mobile": "npm run start --prefix apps/mobile",
    "build:web": "next build",
    "build:backend": "npm run build --prefix backend",
    "build:admin": "npm run build --prefix apps/admin",
    "build": "npm run build:web && npm run build:backend && npm run build:admin"
  },
  "dependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "next": "14.2.29",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "latest"
  }
}
